@using Tujyane.Components

<nav class="navbar navbar-expand-sm bg-dark navbar-dark fixed-top rounded-2 m-1" style="height: 3.5rem;">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Logo</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="collapsibleNavbar">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href=""><Icon Name="IconName.House" class="m-1" />Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="transit"><Icon Name="IconName.BusFront" class="m-1" />Transit</a>
        </li>
      </ul>

      <div class="nav-item d-flex align-items-center ms-auto border rounded-5 px-1" @onclick="ShowLoginModal" style="cursor: pointer;">
        <Icon Name="IconName.PersonCircle" class="m-1 text-light" style="font-size: 1.5rem;" />
        <span class="text-light mx-1">Sign in</span>
      </div>
    </div>
  </div>
</nav>

<!-- Modals -->
<Login @ref="loginModal" OnSignUpClicked="ShowSignUpModal" />
<SignUp @ref="signUpModal" OnLoginClicked="ShowLoginModal" />

@code {
    private Login? loginModal;
    private SignUp? signUpModal;

    private async Task ShowLoginModal()
    {
        if (signUpModal != null)
            await signUpModal.HideAsync(); // avoid overlap

        if (loginModal != null)
            await loginModal.ShowAsync();
    }

    private async Task ShowSignUpModal()
    {
        if (loginModal != null)
            await loginModal.HideAsync();

        if (signUpModal != null)
            await signUpModal.ShowAsync();
    }
}

@namespace Tujyane.Components
@using System.ComponentModel.DataAnnotations;
@using Tujyane.Services;
@inject AuthService AuthService;

<Modal @ref="modal" Title="Login">
    <BodyTemplate>
        <EditForm Model="loginInfo" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <h5 class="text-center mb-3">Welcome Back!</h5>

            <InputStyle Label="Email" IconName="IconName.Envelope" InputId="emailInput">
                <Input>
                    <input id="emailInput"
                           class="form-control"
                           type="text"
                           placeholder="Enter your Email"
                           @bind="loginInfo.Email" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => loginInfo.Email)" />

            <InputStyle Label="Password" IconName="IconName.Lock" InputId="passwordInput">
                <Input>
                    <input id="passwordInput"
                           class="form-control"
                           type="password"
                           placeholder="Enter your Password"
                           @bind="loginInfo.Password" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => loginInfo.Password)" />

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="rememberMe" />
                <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>
            <Button Color="ButtonColor.Secondary" @onclick="HandleCancel">Cancel</Button>
            <button type="submit" class="btn btn-primary">Login</button>
        </EditForm>
    </BodyTemplate>

    <FooterTemplate>
        <span class="text-muted dark float-start">
            Don't have an account?
            <Button Color="ButtonColor.Primary" @onclick="() => OnSignUpClicked.InvokeAsync()">Sign up</Button>
        </span>
        <span class="text-muted float-end dark">Forgot password? <a href="#">Reset</a></span>
        <br />
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;

    [Parameter] public EventCallback OnSignUpClicked { get; set; }

    public async Task ShowAsync() => await modal.ShowAsync();
    public async Task HideAsync() => await modal.HideAsync();

    private LoginInfo loginInfo = new();

    public class LoginInfo
    {
        [Required(ErrorMessage = "Email is required")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }

    private async Task HandleLogin()
    {
        await AuthService.Login(loginInfo.Email, loginInfo.Password);
        HideAsync();
    }

    private void HandleCancel()
    {
        HideAsync();
    }
}

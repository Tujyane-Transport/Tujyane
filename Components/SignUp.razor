@namespace Tujyane.Components
@using System.ComponentModel.DataAnnotations
@using Tujyane.Services
@inject AuthService AuthService;

<Modal @ref="modal" Title="Sign Up">
    <BodyTemplate>
        <EditForm Model="signUpInfo" OnValidSubmit="HandleSignUp">
            <DataAnnotationsValidator />

            <InputStyle Label="Fullname" IconName="IconName.Person" InputId="fullnameInput">
                <Input>
                    <input id="fullnameInput"
                           class="form-control"
                           type="text"
                           placeholder="Enter your full name"
                           @bind="signUpInfo.Fullname" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => signUpInfo.Fullname)" />

            <InputStyle Label="Email" IconName="IconName.Envelope" InputId="emailInput">
                <Input>
                    <input id="emailInput"
                           class="form-control"
                           type="email"
                           placeholder="Enter your email"
                           @bind="signUpInfo.Email" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => signUpInfo.Email)" />

            <InputStyle Label="Phone Number" IconName="IconName.Phone" InputId="phoneInput">
                <Input>
                    <input id="phoneInput"
                           class="form-control"
                           type="tel"
                           placeholder="Enter your phone number"
                           @bind="signUpInfo.PhoneNumber" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => signUpInfo.PhoneNumber)" />

            <InputStyle Label="Password" IconName="IconName.Lock" InputId="passwordInput">
                <Input>
                    <input id="passwordInput"
                           class="form-control"
                           type="password"
                           placeholder="Enter password"
                           @bind="signUpInfo.Password" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => signUpInfo.Password)" />

            <InputStyle Label="Confirm Password" IconName="IconName.Lock" InputId="confirmPasswordInput">
                <Input>
                    <input id="confirmPasswordInput"
                           class="form-control"
                           type="password"
                           placeholder="Confirm password"
                           @bind="signUpInfo.ConfirmPassword" />
                </Input>
            </InputStyle>
            <ValidationMessage For="@(() => signUpInfo.ConfirmPassword)" />

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="rememberMe" />
                <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>
            <Button Color="ButtonColor.Secondary" @onclick="HandleCancel">Cancel</Button>
            <button type="submit" class="btn btn-primary">Sign Up</button>
        </EditForm>
    </BodyTemplate>

    <FooterTemplate>
        <span class="text-muted dark float-start">
            Already have an account?
            <Button Color="ButtonColor.Primary" @onclick="() => OnLoginClicked.InvokeAsync()">Login</Button>
        </span>
        <span class="text-muted float-end dark">Forgot password? <a href="#">Reset</a></span>
        <br />
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;

    [Parameter] public EventCallback OnLoginClicked { get; set; }

    public async Task ShowAsync() => await modal.ShowAsync();
    public async Task HideAsync() => await modal.HideAsync();

    private SignUpInfo signUpInfo = new();

    public class SignUpInfo
    {
        [Required(ErrorMessage = "Fullname is required")]
        public string Fullname { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone number is required")]
        public string PhoneNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    public async Task HandleSignUp()
    {
        await AuthService.Register(signUpInfo.Email, signUpInfo.Password, signUpInfo.Fullname);
        HideAsync();
    }

    private void HandleCancel()
    {
        HideAsync();
    }
}
